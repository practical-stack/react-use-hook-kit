---
import { HookDemos } from '../components/HookDemos'
import '../styles/global.css'

const hooks = [
  {
    name: 'useBoolean',
    importPath: 'react-hook-kit/use-boolean',
    signature: 'useBoolean(initialValue?: boolean)',
    description: 'Boolean state with setTrue, setFalse, toggle, and direct setter helpers.',
  },
  {
    name: 'useToggle',
    importPath: 'react-hook-kit/use-toggle',
    signature: 'useToggle(initialValue?: boolean)',
    description: 'Minimal boolean toggle state for disclosure and switch-like controls.',
  },
  {
    name: 'useCounter',
    importPath: 'react-hook-kit/use-counter',
    signature: 'useCounter(initialValue?: number, options?: { min?: number; max?: number })',
    description: 'Numeric state with increment, decrement, reset, direct setter, and optional bounds.',
  },
  {
    name: 'useDebounce',
    importPath: 'react-hook-kit/use-debounce',
    signature: 'useDebounce<T>(value: T, delay: number)',
    description: 'Returns a delayed value that updates after the configured quiet period.',
  },
  {
    name: 'useLocalStorage',
    importPath: 'react-hook-kit/use-local-storage',
    signature: 'useLocalStorage<T>(key: string, initialValue: T | () => T, options?)',
    description: 'React state synchronized to localStorage with SSR-safe initialization.',
  },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>react-hook-kit</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <div>
          <p class="eyebrow">React 17, 18, and 19</p>
          <h1>react-hook-kit</h1>
          <p class="lede">
            Small, typed React hooks with ESM-first package exports and focused
            behavior for everyday UI state.
          </p>
          <pre><code>pnpm add react-hook-kit</code></pre>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">API</p>
          <h2>Hooks</h2>
        </div>
        <div class="api-list">
          {
            hooks.map((hook) => (
              <article class="api-item">
                <div>
                  <h3>{hook.name}</h3>
                  <p>{hook.description}</p>
                </div>
                <div>
                  <code>{hook.signature}</code>
                  <code>{hook.importPath}</code>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">Demos</p>
          <h2>Interactive Examples</h2>
        </div>
        <HookDemos client:load />
      </section>
    </main>
  </body>
</html>
