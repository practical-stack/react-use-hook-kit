{
  "name": "@repo/source",
  "private": true,
  "scripts": {
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "format": "oxfmt -c .oxfmtrc.json",
    "format:check": "oxfmt -c .oxfmtrc.json --check",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "pnpm typecheck:scripts && turbo run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "turbo run test",
    "sheriff": "sheriff verify",
    "knip": "knip",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm sheriff && pnpm knip"
  },
  "devDependencies": {
    "@softarc/sheriff-core": "^0.19.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.4.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "turbo"
    ]
  }
}
