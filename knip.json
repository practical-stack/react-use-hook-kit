{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["sheriff.config.ts"],
  "ignoreIssues": {
    "packages/react-hook-kit/src/index.ts": ["types"],
    "packages/react-hooks-testing/src/create-hook-renderer.ts": ["types"],
    "packages/react-hooks-testing/src/index.ts": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@astrojs/check", "@vitest/coverage-v8", "vitest"]
    },
    "apps/docs": {
      "entry": ["src/pages/**/*.astro", "src/components/**/*.tsx"],
      "project": ["src/**/*.{astro,ts,tsx}"]
    },
    "packages/react-hook-kit": {
      "entry": ["src/use-*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "packages/react-hooks-testing": {
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    }
  }
}
