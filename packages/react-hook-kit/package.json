{
  "name": "react-use-hook-kit",
  "version": "0.1.0",
  "description": "Small, typed React hooks for everyday UI state.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./use-boolean": {
      "import": {
        "types": "./dist/use-boolean.d.ts",
        "default": "./dist/use-boolean.js"
      },
      "require": {
        "types": "./dist/use-boolean.d.cts",
        "default": "./dist/use-boolean.cjs"
      }
    },
    "./use-counter": {
      "import": {
        "types": "./dist/use-counter.d.ts",
        "default": "./dist/use-counter.js"
      },
      "require": {
        "types": "./dist/use-counter.d.cts",
        "default": "./dist/use-counter.cjs"
      }
    },
    "./use-debounce": {
      "import": {
        "types": "./dist/use-debounce.d.ts",
        "default": "./dist/use-debounce.js"
      },
      "require": {
        "types": "./dist/use-debounce.d.cts",
        "default": "./dist/use-debounce.cjs"
      }
    },
    "./use-local-storage": {
      "import": {
        "types": "./dist/use-local-storage.d.ts",
        "default": "./dist/use-local-storage.js"
      },
      "require": {
        "types": "./dist/use-local-storage.d.cts",
        "default": "./dist/use-local-storage.cjs"
      }
    },
    "./use-toggle": {
      "import": {
        "types": "./dist/use-toggle.d.ts",
        "default": "./dist/use-toggle.js"
      },
      "require": {
        "types": "./dist/use-toggle.d.cts",
        "default": "./dist/use-toggle.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:attw": "attw --pack --profile node16",
    "test:publint": "publint",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "publint": "^0.3.20",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=17 <20",
    "react-dom": ">=17 <20"
  }
}
